# --- LLM stack ---
AZURE_OPENAI_API_KEY=""
AZURE_OPENAI_API_ENDPOINT=""
AZURE_OPENAI_API_VERSION=""
AZURE_OPENAI_VISION_DEPLOYMENT=""
# Azure deployment names used for task extraction / replies
TEXT_MODEL_NAME="gpt-4.1"
SMALL_TEXT_MODEL_NAME="gpt-4.1"

# Groq — only needed for voice-note transcription (optional)
GROQ_API_KEY=""

# --- WhatsApp Cloud API (the ANGC assistant number) ---
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_TOKEN=""
WHATSAPP_ACCESS_TOKEN=""   # same value as WHATSAPP_TOKEN
WHATSAPP_VERIFY_TOKEN=""

# --- ANGC executive assistant ---
# NG Sir's WhatsApp number(s), comma separated, e.g. "919876543210"
DIRECTOR_PHONE_NUMBERS=""
# SQLite file for tasks + dashboard users
ANGC_DB_PATH="data/angc_tasks.db"
# WhatsApp-notify assignee on new task / NG Sir on completion
ANGC_NOTIFY_ASSIGNEES=true
# Admin (Nikhil Gupta) dashboard login email
ANGC_ADMIN_EMAIL="director@angcgroup.com"
# First-login password for all seeded users — change after first login
ANGC_DEFAULT_PASSWORD="Angc@2026"
# Long random string; sessions reset on restart if left empty
ANGC_SESSION_SECRET=""
# Public dashboard URL included in WhatsApp notifications (optional)
ANGC_DASHBOARD_URL=""
